/* 通用设置 */
* {
    background-color: #ffffff; /* 设置背景为白色 */
    color: #000000;           /* 设置文本颜色为黑色 */
}

/* 窗口 */
QWidget {
    background-color: #ffffff;
}

/* 按钮 */
QPushButton {
    font:13px;
    color:white;
    background-color:dodgerblue;
    border-radius:5px;
    height:25px;
    width:110px;
    border:none;
}

QPushButton:hover {
    background-color:#3498db;
}

QPushButton:pressed {
    background-color:#3498db;
    padding-left:1px;
    padding-top:1px;
}

/* 标签 */
QLabel {
    background-color: transparent; /* 标签背景透明 */
    color: #000000;
}

/* 文本输入框 */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #000000;
}

/* 下拉菜单 */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    padding: 3px;
    color: #000000;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    selection-background-color: #e0e0e0;
}

/* 滚动条 */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 15px;
    margin: 15px 3px 15px 3px;
    border: 1px solid #dcdcdc;
}

QScrollBar::handle:vertical {
    background: #dcdcdc;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: #f0f0f0;
    border: 1px solid #dcdcdc;
    height: 15px;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover, QScrollBar::sub-line:vertical:hover {
    background: #e0e0e0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 表格 */
QTableView {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    gridline-color: #dcdcdc;
    color: #000000;
}

QHeaderView::section {
    background-color: #f0f0f0;
    border: 1px solid #dcdcdc;
    padding: 4px;
}

/* 工具提示 */
QToolTip {
    background-color: #f0f0f0;
    border: 1px solid #dcdcdc;
    color: #000000;
    padding: 5px;
    border-radius: 3px;
}

QListWidget{
     background-color: #ffffff;
     color: #000000;
     border: none;
     outline: none;
}

QListWidget::item {
    background-color: #ffffff;
}

QListWidget::item:hover {
    background-color: rgba(153, 221, 255, 0.63);
    border: none;
}

QListWidget::item:selected {
    background-color: rgba(153, 221, 255, 0.63);
    color: #000000;
}

QListWidget#chatListWidget {
    background-color: rgb(247, 247, 247);
    color: rgb(51, 51, 51);
    border: none;
    outline: none;
}

QListWidget#chatListWidget::item {
    background-color: none;
}

QListWidget#chatListWidget::item:hover {
    background-color: none;
}

QListWidget#chatListWidget::item:selected {
    background-color: none;
    border: none;
}

QListWidget#chatListWidget::item:focus {
    border: none;
}

ChatBubbleLeft {
    background-color: #ffffff;
}

ChatBubbleRight {
    background-color: #cceaff;
}

/* 菜单 */
QMenu {
    background-color: #f7f7f7; /* 设置菜单背景颜色 */
    border: 1px solid #dcdcdc; /* 设置菜单边框颜色 */
    padding: 5px;              /* 设置菜单内边距 */
    border-radius: 5px;        /* 设置菜单边框圆角 */
}

QMenu::item {
    background-color: transparent; /* 菜单项背景透明 */
    padding: 5px 20px;             /* 设置菜单项内边距 */
    border-radius: 3px;            /* 设置菜单项边框圆角 */
}

QMenu::item:selected {
    background-color: #e0e0e0; /* 设置选中菜单项背景颜色 */
    color: #000000;            /* 设置选中菜单项文字颜色 */
}

QMenu::separator {
    height: 1px;
    background: #dcdcdc;
    margin: 5px 0;
}

/* 菜单栏 */
QMenuBar {
    background-color: #ffffff; /* 设置菜单栏背景颜色 */
    padding: 2px;              /* 设置菜单栏内边距 */
}

QMenuBar::item {
    background-color: transparent; /* 菜单项背景透明 */
    padding: 5px 10px;             /* 设置菜单项内边距 */
    border-radius: 3px;            /* 设置菜单项边框圆角 */
}

QMenuBar::item:selected {
    background-color: #e0e0e0; /* 设置选中菜单项背景颜色 */
    color: #000000;            /* 设置选中菜单项文字颜色 */
}

QMenuBar::item:pressed {
    background-color: #d0d0d0; /* 设置按下菜单项背景颜色 */
    color: #000000;            /* 设置按下菜单项文字颜色 */
}
